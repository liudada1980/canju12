<?xml version="1.0" encoding="utf-8"?>
<!-- 横屏布局：棋盘左侧，右侧面板用权重分配让按钮区域垂直居中
     棋盘的宽度和左边距由 adjustBoardSizeForLandscape() 程序化设置 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:fitsSystemWindows="true">

    <!-- 象棋棋盘区域 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/boardFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/ivBoard"
            android:scaleType="fitCenter"/>

        <com.canju12.zhuzicanju.ChessView
            android:id="@+id/chessView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 右侧面板：标题(上) + 按钮区(居中) + 信息(下)，用weight让按钮区居中 -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:paddingTop="6dp"
        app:layout_constraintStart_toEndOf="@id/boardFrame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 标题（居中） -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="题目序号"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="20sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tv_title_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="18sp"
            android:textColor="#000000"
            android:gravity="center"/>

        <!-- 上方弹性空间 -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- 按钮区域（垂直居中） -->

        <!-- 第1行：行棋指示器 -->
        <ImageView
            android:id="@+id/ivTurnIndicator"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/bk"
            android:scaleType="fitCenter"
            android:layout_marginBottom="4dp"/>

        <!-- 第2行：题库、选关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnTiku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="题库"
                android:textColor="#000000"
                android:textSize="14sp"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="none"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_rounded"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnSelectLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选关"
                android:textColor="#000000"
                android:textSize="14sp"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="none"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_rounded"/>
        </LinearLayout>

        <!-- 第3行：悔棋、收藏夹 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <Button
                android:id="@+id/btnRegret"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="悔棋"
                android:textColor="#000000"
                android:textSize="14sp"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="none"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_rounded"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收藏"
                android:textColor="#000000"
                android:textSize="14sp"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="none"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_rounded"/>
        </LinearLayout>

        <!-- 第4行：重来、拆解 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <Button
                android:id="@+id/btnRepeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重来"
                android:textColor="#000000"
                android:textSize="14sp"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="none"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_rounded"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnAnalyze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拆解"
                android:textColor="#000000"
                android:textSize="14sp"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="none"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_rounded"/>
        </LinearLayout>

        <!-- 第5行：不会、已会 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <Button
                android:id="@+id/btnNonono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不会"
                android:textColor="#000000"
                android:textSize="14sp"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="none"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_rounded"/>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnYesyes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已会"
                android:textColor="#000000"
                android:textSize="14sp"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="none"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_rounded"/>
        </LinearLayout>

        <!-- 下方弹性空间 -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- 信息区域：计时、正确率 -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:text="本题用时：mm:ss/mm:ss"
            android:textSize="14sp"
            android:textColor="#000000"
            android:gravity="center"
            android:textAlignment="center"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:includeFontPadding="false"
            android:typeface="monospace"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/tv_accuracy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="进度/正确率：000/000 (100%)"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:textSize="14sp"
            android:textColor="#000000"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:fontFamily="monospace"
            android:paddingBottom="30dp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <!-- 诗句：棋盘左侧区域70%位置，竖排显示，垂直居中 -->
    <TextView
        android:id="@+id/shiju"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="一二残局"
        android:textSize="14sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/boardFrame"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.7"/>

    <!-- Readme文字 -->
    <TextView
        android:id="@+id/tvQQGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="一二残局    "
        android:textSize="14sp"
        android:textColor="#000000"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
